# ResearchLoop Evo Backend Configuration
# Copy this file to .env and adjust values as needed.

# Polite pool email for OpenAlex / Crossref (optional but recommended)
RLE_MAILTO=your-email@example.com

# Data directory (SQLite DB + HTTP cache)
RLE_DATA_DIR=./var
RLE_CACHE_DIR=./var/http-cache
RLE_DB_PATH=./var/researchloop.db

# HTTP request timeouts (seconds)
RLE_REQUEST_TIMEOUT=20.0
RLE_ARXIV_TIMEOUT=15.0

# HTTP cache TTL (seconds, default 24h)
RLE_CACHE_TTL=86400

# Rate limits (requests per second, per source)
RLE_RATE_OPENALEX=8.0
RLE_RATE_CROSSREF=4.0
RLE_RATE_ARXIV=0.3
RLE_ARXIV_MIN_INTERVAL=3.0

# Concurrency and retries
RLE_MAX_CONCURRENCY=6
RLE_MAX_RETRIES=2

# Keyword and result limits
RLE_MAX_KEYWORDS=6
RLE_DEFAULT_TOP_K=40
RLE_MAX_TOP_K=200
RLE_PER_QUERY_LIMIT=50

# Deduplication thresholds
RLE_TITLE_JACCARD=0.85
RLE_TITLE_RATIO=0.92

# LLM extraction (DISABLED by default in Phase 1)
RLE_LLM_ENABLED=0
RLE_LLM_MAX_CALLS=20

# CORS origins (comma-separated)
RLE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
