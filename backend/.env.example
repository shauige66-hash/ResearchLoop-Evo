# ResearchLoop Evo Backend Configuration
# Copy this file to .env and adjust values as needed.

# Polite pool email for OpenAlex / Crossref (optional but recommended)
RLE_MAILTO=your-email@example.com

# Data directory (SQLite DB + HTTP cache)
RLE_DATA_DIR=./var
RLE_CACHE_DIR=./var/http-cache
RLE_DB_PATH=./var/researchloop.db

# HTTP request timeouts (seconds)
RLE_REQUEST_TIMEOUT=20.0
RLE_ARXIV_TIMEOUT=15.0

# HTTP cache TTL (seconds, default 24h)
RLE_CACHE_TTL=86400

# Rate limits (requests per second, per source)
RLE_RATE_OPENALEX=8.0
RLE_RATE_CROSSREF=4.0
RLE_RATE_ARXIV=0.3
RLE_ARXIV_MIN_INTERVAL=3.0

# Concurrency and retries
RLE_MAX_CONCURRENCY=6
RLE_MAX_RETRIES=2

# Keyword and result limits
RLE_MAX_KEYWORDS=6
RLE_DEFAULT_TOP_K=40
RLE_MAX_TOP_K=200
RLE_PER_QUERY_LIMIT=50

# Deduplication thresholds
RLE_TITLE_JACCARD=0.85
RLE_TITLE_RATIO=0.92

# ---------------------------------------------------------------------------
# LLM provider (OpenAI-compatible). DISABLED by default: with no key the system
# reports LLM_NOT_CONFIGURED and runs the deterministic path only. It never
# fabricates an LLM result. Fill these in with your own provider credentials.
# The key stays on the server: it is never stored in the DB, logged, or sent to
# the frontend.
RLE_LLM_ENABLED=0
RLE_LLM_API_KEY=
RLE_LLM_BASE_URL=
RLE_LLM_MODEL=
RLE_LLM_TIMEOUT=60.0

# Global ceiling on real HTTP attempts (failures count, cache hits do not).
# A 25-paper gap pipeline needs roughly 1 planner + 25 analyst + 2 gap + 5 critic
# + 5 counter-query calls, so the default leaves room for one full run.
RLE_LLM_MAX_CALLS=60

# Cache identical (role, model, prompt version, prompt) replies in SQLite so a
# resume never pays twice for the same paper.
RLE_LLM_CACHE=1

# Per-role ceilings, applied on top of the global budget.
RLE_LLM_RESEARCH_PLANNER_MAX=1
RLE_LLM_LITERATURE_ANALYST_MAX=30
RLE_LLM_GAP_ANALYST_MAX=2
RLE_LLM_GAP_CRITIC_MAX=5
RLE_LLM_COUNTER_QUERY_MAX=5
RLE_LLM_CANDIDATE_PROPOSER_MAX=20

# Deterministic gap gate. Passing it means "reached the configured evidence
# thresholds within the current search scope", never "novelty is proven".
RLE_GATE_MIN_SUPPORTING_PAPERS=3
RLE_GATE_MIN_EVIDENCE_GROUNDING=3
RLE_GATE_MIN_CROSS_PAPER_SUPPORT=3
RLE_GATE_MIN_SPECIFICITY=3
RLE_GATE_MIN_TESTABILITY=3
RLE_GATE_MAX_NOVELTY_RISK=MEDIUM
RLE_GATE_MAX_CONTRADICTION_RISK=MEDIUM
RLE_GATE_REQUIRE_COUNTER_SEARCH_SUCCESS=1
RLE_GATE_MAX_PRIOR_ART_COLLISIONS=0

# CORS origins (comma-separated)
RLE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
